// MODELO DE DOMINIO DE REFERENCIA — RoxCoach
//
// Documento de diseño. NO lo usa Prisma: el esquema activo (fuente de verdad)
// es prisma/schema.prisma. Este archivo muestra el modelo completo previsto y
// en qué fase se implementa cada parte:
//
//   [IMPLEMENTADO]  ya existe en prisma/schema.prisma (resumen; ver el esquema
//                   para @map, índices y reglas SQL de las migraciones).
//   [FASE 4]        biblioteca de ejercicios (implementada).
//   [FASE 5]        plantillas: WorkoutTemplate, WorkoutBlock y BlockExercise
//                   (implementadas; el esquema real usa target_type con un solo
//                   objetivo por ejercicio, carga en kg, estimated_minutes y la
//                   FK al ejercicio diferida — ver prisma/schema.prisma).
//   [FASE 6]        programación: ScheduledSession y Assignment (implementadas;
//                   el esquema real separa scheduled_date (DATE) y start_time
//                   ("HH:MM" opcional), usa estados programada/cancelada en la
//                   sesión y asignada/retirada en la asignación, y aún no tiene
//                   overrides — ver prisma/schema.prisma).
//   [FASE 7]        ejecución: SessionLog, SetLog y DiscomfortReport (implementadas;
//                   las series se ubican por su posición en el snapshot —
//                   bloque, ejercicio, serie— y la pausa se guarda con
//                   paused_at / paused_seconds — ver prisma/schema.prisma).
//   [FASE 8]        progreso: SIN tablas nuevas. Todo se calcula de
//                   assignments, scheduled_sessions (snapshot), session_logs,
//                   set_logs y discomfort_reports (lib/progress). No se guardan
//                   métricas derivadas.
//   [FUTURO]        diseño previsto; puede cambiar al implementarse.
//
// Separación obligatoria del dominio (CLAUDE.md):
//   Exercise → WorkoutTemplate → ScheduledSession → Assignment → SessionLog/SetLog
// Lo planeado nunca se sobrescribe con lo realizado.
//
// Convenciones del esquema real: ids UUID, tablas en snake_case, FK de rol a
// coach_profiles / athlete_profiles (la BD garantiza el rol), RLS activo sin
// políticas (solo el servidor accede vía Prisma).

// ============================================================================
// [IMPLEMENTADO] Identidad y perfiles (fase 2)
// ============================================================================

enum Role {
  coach
  athlete
}

/// profiles.id = auth.users.id (Supabase Auth). Lo crea un trigger al registrarse.
model Profile {
  id    String @id @db.Uuid
  email String
  name  String
  role  Role

  coach   CoachProfile?
  athlete AthleteProfile?
}

model CoachProfile {
  profileId    String  @id @db.Uuid
  gymName      String?
  weightUnit   String // kg | lb
  distanceUnit String // km | mi

  athletes    CoachAthlete[]
  invitations Invitation[]
  exercises   Exercise[] // [FASE 4]
  templates   WorkoutTemplate[] // [FUTURO]
  sessions    ScheduledSession[] // [FUTURO]
}

model AthleteProfile {
  profileId     String    @id @db.Uuid
  division      String?
  raceDate      DateTime? @db.Date
  availableDays String[]
  equipment     String[] // mismo catálogo que Exercise.equipment
  weightUnit    String

  coaches             CoachAthlete[]
  acceptedInvitations Invitation[]
  assignments         Assignment[] // [FUTURO]
}

// ============================================================================
// [IMPLEMENTADO] Relación coach–atleta e invitaciones (fase 3)
// ============================================================================

enum RelationStatus {
  active
  paused
  removed
}

enum InvitationStatus {
  pending
  accepted
  cancelled
}

/// Un atleta tiene como máximo UNA relación active/paused (índice único parcial).
model CoachAthlete {
  id        String         @id @db.Uuid
  coachId   String         @db.Uuid // → CoachProfile
  athleteId String         @db.Uuid // → AthleteProfile
  status    RelationStatus
  joinedAt  DateTime
  pausedAt  DateTime?
  removedAt DateTime?

  @@unique([coachId, athleteId])
}

/// Ligada a un correo; solo se guarda el hash SHA-256 del token. Vence a 7 días.
model Invitation {
  id           String           @id @db.Uuid
  coachId      String           @db.Uuid
  email        String
  name         String?
  tokenHash    String           @unique
  status       InvitationStatus
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?          @db.Uuid // SET NULL si el atleta elimina su cuenta
}

// ============================================================================
// [FASE 4] Biblioteca de ejercicios
// ============================================================================

/// Categorías fijas del sistema (ampliarlas requiere migración).
enum ExerciseCategory {
  carrera
  estaciones
  fuerza
  movilidad
}

enum ExerciseDifficulty {
  principiante
  intermedio
  avanzado
}

enum ExerciseMediaType {
  video
  imagen
}

/// coachId NULL = ejercicio del sistema (lo carga una migración, nadie lo edita).
/// coachId con valor = ejercicio personalizado, visible y editable solo por su coach.
/// Archivar (archivedAt) lo oculta de la biblioteca sin borrarlo: las plantillas
/// futuras podrán seguir referenciándolo.
model Exercise {
  id           String              @id @db.Uuid
  coachId      String?             @db.Uuid // → CoachProfile (CASCADE)
  /// Si es copia de un ejercicio del sistema ("Duplicar como propio").
  sourceId     String?             @db.Uuid // → Exercise (SET NULL)
  name         String
  category     ExerciseCategory
  difficulty   ExerciseDifficulty
  instructions String // pasos de ejecución (nivel 3: se muestran bajo demanda)
  cue          String? // indicación clave, breve (nivel 2)
  equipment    String[] // catálogo EQUIPMENT_OPTIONS
  mediaType    ExerciseMediaType?
  mediaUrl     String? // solo https; los videos se abren como enlace externo
  archivedAt   DateTime?
  createdAt    DateTime
  updatedAt    DateTime

  substitutions ExerciseSubstitution[] @relation("ExerciseSubstitutions")
  substituteOf  ExerciseSubstitution[] @relation("SubstituteExercises")
  blockItems    BlockExercise[] // [FUTURO]
}

/// "exercise se puede sustituir por substitute" (dirigida; máx. 5 por ejercicio;
/// sin auto-referencias). Solo los ejercicios personalizados definen las suyas.
model ExerciseSubstitution {
  exerciseId   String @db.Uuid
  substituteId String @db.Uuid
  position     Int

  @@id([exerciseId, substituteId])
}

// ============================================================================
// [FASE 5] Plantillas (resumen) · [FUTURO] programación, asignación y registro
// ============================================================================

enum Intensity {
  baja
  media
  alta
}

enum TemplateStatus {
  borrador
  publicada
  archivada
}

// [DESCARTADO] Estado de ejecución en la asignación. Desde la fase 7 la
// asignación solo tiene asignada/retirada y el progreso vive en SessionLog
// (en_curso / completada; sin registro = sin iniciar).
enum AssignmentStatus {
  programada
  en_curso
  completada
  omitida
}

model WorkoutTemplate {
  id              String         @id @db.Uuid
  coachId         String         @db.Uuid
  name            String
  focus           String?
  durationMinutes Int
  intensity       Intensity
  status          TemplateStatus

  blocks   WorkoutBlock[]
  sessions ScheduledSession[]
}

model WorkoutBlock {
  id         String @id @db.Uuid
  templateId String @db.Uuid // CASCADE
  order      Int
  name       String
  summary    String?

  exercises BlockExercise[]
}

/// Prescripción planeada (objetivos). Nunca guarda resultados reales.
model BlockExercise {
  id              String @id @db.Uuid
  blockId         String @db.Uuid // CASCADE
  exerciseId      String @db.Uuid // → Exercise (los archivados siguen referenciables)
  order           Int
  sets            Int
  reps            Int?
  distanceMeters  Float?
  loadKg          Float?
  durationSeconds Int?
  restSeconds     Int?
}

/// [FASE 6 — implementado; ver prisma/schema.prisma para los campos reales]
/// Copia programada de una plantilla en una fecha. Editarla no altera la plantilla.
model ScheduledSession {
  id          String   @id @db.Uuid
  coachId     String   @db.Uuid
  templateId  String?  @db.Uuid
  name        String
  scheduledAt DateTime
  snapshot    Json // bloques y prescripción congelados al programar

  assignments Assignment[]
}

/// [FASE 6 — implementado sin overrides; personalizar por atleta queda pendiente]
/// Sesión asignada a un atleta; permite personalizar sin afectar a otros.
model Assignment {
  id        String           @id @db.Uuid
  sessionId String           @db.Uuid
  athleteId String           @db.Uuid // → AthleteProfile
  status    AssignmentStatus
  overrides Json? // ajustes individuales sobre el snapshot

  log SessionLog?

  @@unique([sessionId, athleteId])
}

/// [FASE 7 — implementado; ver prisma/schema.prisma para los campos reales]
/// Registro realizado (resultados reales).
model SessionLog {
  id           String    @id @db.Uuid
  assignmentId String    @unique @db.Uuid
  startedAt    DateTime
  finishedAt   DateTime?
  comment      String?

  sets SetLog[]
}

/// [FASE 7 — implementado]
model SetLog {
  id                    String   @id @db.Uuid
  sessionLogId          String   @db.Uuid // CASCADE
  blockExerciseId       String   @db.Uuid // referencia a lo planeado, sin modificarlo
  setNumber             Int
  actualReps            Int?
  actualDistanceMeters  Float?
  actualLoadKg          Float?
  actualDurationSeconds Int?
  rpe                   Int?
  createdAt             DateTime
}
