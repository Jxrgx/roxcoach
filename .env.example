# RoxCoach: plantilla de variables de entorno.
# Copia este archivo a `.env.local` (desarrollo) y complétalo. `.env.local` y
# cualquier `.env.*` con valores reales NUNCA se versionan (.gitignore).
# En staging y producción las variables se configuran en el proveedor de
# despliegue, no en archivos. Guía completa: docs/deployment.md.
# El catálogo de variables vive en lib/config/env-rules.ts (ENV_VARS).
#
# Ambientes (fase 15, Vercel):
#   Development (local, .env.local) → roxcoach-dev
#   Preview (Vercel, ramas y PR)    → roxcoach-dev (datos de prueba; NUNCA prod)
#   Production (Vercel)             → roxcoach-prod
# Nunca mezcles llaves o bases de datos entre proyectos: la validación compara el
# proyecto de NEXT_PUBLIC_SUPABASE_URL con el de DATABASE_URL y DIRECT_URL.

# --- Públicas (se incrustan en el JavaScript del navegador) ------------------
# Solo valores que pueden ser públicos. Nunca pongas un secreto con NEXT_PUBLIC_.
# Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_…). Protegida por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Servidor (solo en el servidor; obligatorias en producción) --------------
# Runtime de la app: pooler en modo transacción (puerto 6543). SECRETO.
# Connect → ORMs → Prisma.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Origen público de la app, sin ruta ni barra final. Los enlaces de
# confirmación de correo e invitación se construyen SIEMPRE con este valor
# (nunca con la cabecera Host). Obligatoria en producción y con https.
# También debe existir al compilar (HSTS y CSP se calculan en el build).
# Desarrollo: http://localhost:3000 · Producción: https://roxcoach.vercel.app
# Vercel Preview: puede omitirse (se usa la URL de la rama, VERCEL_BRANCH_URL).
# Vercel Production: obligatoria; EXACTAMENTE la URL de producción del proyecto
# (VERCEL_PROJECT_PRODUCTION_URL), nunca la de un deployment o de Preview.
APP_URL=http://localhost:3000
# Opcional: orígenes extra aceptados, separados por coma (sin dominio propio: vacía en Production).
ALLOWED_ORIGINS=
# Opcional: "1" habilita el catálogo de componentes en /componentes.
# Solo desarrollo y pruebas; NUNCA en producción.
ROXCOACH_CATALOG=
# Opcional: "1" registra cada consulta (duración y SQL parametrizado, sin valores)
# para medir la navegación (scripts/measure-navigation.mjs). Solo en local.
ROXCOACH_DB_TRACE=

# --- Migraciones (solo la CLI de Prisma y npm run db:audit) -----------------
# Conexión de sesión (puerto 5432). SECRETO. No hace falta en el runtime.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Pruebas E2E (solo local; la validación las RECHAZA en cualquier ambiente de Vercel)
# Secret key (sb_secret_…): la usa SOLO el setup de Playwright para crear
# usuarios de prueba. La app no la usa. SECRETO. Nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Usuarios de prueba que crea el setup en el proyecto de DESARROLLO.
E2E_COACH_EMAIL=coach.e2e@example.com
E2E_ATHLETE_EMAIL=atleta.e2e@example.com
# Contraseña de cada usuario de prueba (mínimo 8 caracteres). SECRETO.
# Alternativa: E2E_PASSWORD como contraseña compartida para ambos.
E2E_COACH_PASSWORD=
E2E_ATHLETE_PASSWORD=
E2E_PASSWORD=
# Obsoletas: ningún archivo las usa (las e2e usan E2E_*). Retíralas de tu .env.local.
TEST_COACH_PASSWORD=
TEST_ATHLETE_PASSWORD=

# --- Dataset de demostración (npm run demo:seed; solo local, NUNCA en Vercel) ---
# Solo se permite contra el proyecto cuyo ref coincida (roxcoach-dev). Ver
# docs/development-workflow.md → Dataset de demostración.
DEMO_TARGET_PROJECT_REF=
# Coach existente dueño del dataset (no se modifica). Por defecto jorgocios@gmail.com.
DEMO_EXISTING_COACH_EMAIL=
# Cuentas de los 3 atletas demo (se crean confirmadas, sin enviar correo).
# Usa correos que controles (p. ej. tu+demo-activo@...), nunca @example.com.
DEMO_ATHLETE_ACTIVE_EMAIL=
DEMO_ATHLETE_ACTIVE_PASSWORD=
DEMO_ATHLETE_PAUSED_EMAIL=
DEMO_ATHLETE_PAUSED_PASSWORD=
DEMO_ATHLETE_PROGRESS_EMAIL=
DEMO_ATHLETE_PROGRESS_PASSWORD=

# --- Vercel (las define Vercel automáticamente: NO las configures a mano) --------
#   VERCEL=1, VERCEL_ENV=development|preview|production, VERCEL_URL, VERCEL_BRANCH_URL,
#   VERCEL_PROJECT_PRODUCTION_URL (roxcoach.vercel.app; se compara con APP_URL).
#   La app las usa para derivar APP_URL en Preview y para validar el build.
#   Cambiar una variable en el dashboard de Vercel requiere un NUEVO deployment.

# --- SMTP (NO va aquí) -------------------------------------------------------
# El correo de confirmación lo envía Supabase Auth. El SMTP propio se configura
# en Supabase Dashboard → Authentication → Emails → SMTP Settings, nunca en la
# app ni en este archivo. Datos a reunir (ver docs/deployment.md → SMTP):
#   host, puerto (587 STARTTLS o 465 TLS), usuario, contraseña (en el
#   dashboard), remitente (no-reply@<dominio-de-envío>) y nombre del remitente.
#   Opcional en el piloto: sin SMTP propio, Supabase solo entrega a miembros de la
#   organización (ver docs/deployment.md §6.0).
