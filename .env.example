# RoxCoach: plantilla de variables de entorno.
# Copia este archivo a `.env.local` y complétalo. `.env.local` NUNCA se versiona.
# Valores en Supabase Dashboard → Project Settings.

# --- Supabase (público: se envía al navegador) -------------------------------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (secreto: solo servidor y pruebas) -----------------------------
# Project Settings → API Keys → Secret key (sb_secret_…).
# La app NO la usa en tiempo de ejecución; solo el setup de pruebas E2E
# para crear los usuarios de prueba. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Base de datos (Prisma) ---------------------------------------------------
# Connect → ORMs → Prisma.
# Runtime de la app: pooler en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migraciones: conexión de sesión (puerto 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Pruebas E2E ----------------------------------------------------------------
# Usuarios de prueba que crea el setup de Playwright en el proyecto de DESARROLLO.
E2E_COACH_EMAIL=coach.e2e@example.com
E2E_ATHLETE_EMAIL=atleta.e2e@example.com
# Contraseña de cada usuario de prueba (mínimo 8 caracteres).
# Alternativa: E2E_PASSWORD como contraseña compartida para ambos.
E2E_COACH_PASSWORD=
E2E_ATHLETE_PASSWORD=
