// RoxCoach: esquema activo (fase 6: identidad, perfiles, relación coach–atleta,
// invitaciones, biblioteca, plantillas, sesiones programadas y asignaciones).
// El modelo de dominio completo previsto está en docs/data-model-draft.prisma.
//
// Las filas de `profiles` se crean con un trigger sobre `auth.users`
// (ver prisma/migrations/*_init_profiles). `profiles.id` = `auth.users.id`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  coach
  athlete

  @@map("role")
}

enum WeightUnit {
  kg
  lb

  @@map("weight_unit")
}

enum DistanceUnit {
  km
  mi

  @@map("distance_unit")
}

model Profile {
  /// Igual a auth.users.id (FK con borrado en cascada, definida en SQL).
  id        String   @id @db.Uuid
  email     String
  name      String
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  coach   CoachProfile?
  athlete AthleteProfile?

  @@map("profiles")
}

model CoachProfile {
  profileId    String       @id @map("profile_id") @db.Uuid
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  gymName      String?      @map("gym_name")
  weightUnit   WeightUnit   @default(kg) @map("weight_unit")
  distanceUnit DistanceUnit @default(km) @map("distance_unit")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  athletes         CoachAthlete[]
  invitations      Invitation[]
  exercises        Exercise[]
  templates        WorkoutTemplate[]
  sessions         ScheduledSession[]
  alerts           CoachAlert[]
  overridesCreated AssignmentOverride[] @relation("OverrideCreatedBy")
  overridesUpdated AssignmentOverride[] @relation("OverrideUpdatedBy")

  @@map("coach_profiles")
}

model AthleteProfile {
  profileId     String     @id @map("profile_id") @db.Uuid
  profile       Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// División HYROX (validada en la app; ver lib/validations).
  division      String?
  raceDate      DateTime?  @map("race_date") @db.Date
  availableDays String[]   @default([]) @map("available_days")
  equipment     String[]   @default([])
  weightUnit    WeightUnit @default(kg) @map("weight_unit")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  coaches             CoachAthlete[]
  acceptedInvitations Invitation[]
  assignments         Assignment[]
  alerts              CoachAlert[]

  @@map("athlete_profiles")
}

enum RelationStatus {
  active
  paused
  removed

  @@map("relation_status")
}

enum InvitationStatus {
  pending
  accepted
  cancelled

  @@map("invitation_status")
}

/// Relación coach–atleta. Las FK apuntan a los perfiles de rol, así la base de
/// datos garantiza que coachId sea coach y athleteId sea atleta.
/// Regla: un atleta tiene como máximo UNA relación activa o en pausa (índice
/// único parcial definido en SQL, migración add_coach_athletes).
model CoachAthlete {
  id        String         @id @default(uuid()) @db.Uuid
  coachId   String         @map("coach_id") @db.Uuid
  coach     CoachProfile   @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  athleteId String         @map("athlete_id") @db.Uuid
  athlete   AthleteProfile @relation(fields: [athleteId], references: [profileId], onDelete: Cascade)
  status    RelationStatus @default(active)
  joinedAt  DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  pausedAt  DateTime?      @map("paused_at") @db.Timestamptz(6)
  removedAt DateTime?      @map("removed_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([coachId, athleteId])
  @@index([athleteId])
  @@map("coach_athletes")
}

/// Invitación de un coach a un atleta, ligada a un correo.
/// El token nunca se guarda: solo su hash SHA-256. "Expirada" se calcula con
/// expiresAt (no hay tarea programada).
model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  coachId      String           @map("coach_id") @db.Uuid
  coach        CoachProfile     @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  /// En minúsculas. Solo una cuenta con este correo puede aceptar.
  email        String
  name         String?
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(pending)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  acceptedBy   AthleteProfile?  @relation(fields: [acceptedById], references: [profileId], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([coachId, status])
  @@index([email])
  @@map("invitations")
}

enum ExerciseCategory {
  carrera
  estaciones
  fuerza
  movilidad

  @@map("exercise_category")
}

enum ExerciseDifficulty {
  principiante
  intermedio
  avanzado

  @@map("exercise_difficulty")
}

enum ExerciseMediaType {
  video
  imagen

  @@map("exercise_media_type")
}

/// Ejercicio de la biblioteca.
/// coachId NULL = ejercicio del sistema (lo cargan las migraciones; nadie lo edita).
/// coachId con valor = personalizado: visible y editable solo por su coach.
/// archivedAt lo oculta de la biblioteca sin borrarlo (las plantillas futuras
/// podrán seguir referenciándolo).
model Exercise {
  id           String             @id @default(uuid()) @db.Uuid
  coachId      String?            @map("coach_id") @db.Uuid
  coach        CoachProfile?      @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  /// Ejercicio del que se duplicó ("Duplicar como propio"), si aplica.
  sourceId     String?            @map("source_id") @db.Uuid
  source       Exercise?          @relation("ExerciseCopies", fields: [sourceId], references: [id], onDelete: SetNull)
  copies       Exercise[]         @relation("ExerciseCopies")
  name         String
  category     ExerciseCategory
  difficulty   ExerciseDifficulty
  instructions String
  /// Indicación clave, breve.
  cue          String?
  /// Catálogo EQUIPMENT_OPTIONS (el mismo del perfil del atleta).
  equipment    String[]           @default([])
  mediaType    ExerciseMediaType? @map("media_type")
  /// Solo https (validado en la app y en la BD).
  mediaUrl     String?            @map("media_url")
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  substitutions        ExerciseSubstitution[] @relation("ExerciseSubstitutions")
  substituteOf         ExerciseSubstitution[] @relation("SubstituteExercises")
  blockItems           BlockExercise[]
  overrideReplacements AssignmentOverride[]   @relation("OverrideReplacement")

  @@index([coachId, archivedAt])
  @@index([category])
  @@map("exercises")
}

/// "exercise se puede sustituir por substitute" (dirigida, ordenada).
/// Máx. 5 por ejercicio (regla de la app); sin auto-referencias (CHECK en SQL).
model ExerciseSubstitution {
  exerciseId   String   @map("exercise_id") @db.Uuid
  exercise     Exercise @relation("ExerciseSubstitutions", fields: [exerciseId], references: [id], onDelete: Cascade)
  substituteId String   @map("substitute_id") @db.Uuid
  substitute   Exercise @relation("SubstituteExercises", fields: [substituteId], references: [id], onDelete: Cascade)
  position     Int      @default(0)

  @@id([exerciseId, substituteId])
  @@index([substituteId])
  @@map("exercise_substitutions")
}

enum WorkoutIntensity {
  baja
  media
  alta

  @@map("workout_intensity")
}

enum TemplateStatus {
  borrador
  publicada
  archivada

  @@map("template_status")
}

/// Tipo de objetivo de un ejercicio dentro de un bloque.
enum TargetType {
  reps
  distance
  time

  @@map("target_type")
}

/// Plantilla de entrenamiento reutilizable del coach (PLANEADO, nunca resultados).
/// Borrador: puede estar incompleta. Publicada: completa (se podrá programar).
/// Archivada: oculta sin borrar.
model WorkoutTemplate {
  id               String           @id @default(uuid()) @db.Uuid
  coachId          String           @map("coach_id") @db.Uuid
  coach            CoachProfile     @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  name             String
  focus            String?
  intensity        WorkoutIntensity @default(media)
  /// Minutos aproximados, los define el coach (requerido para publicar).
  estimatedMinutes Int?             @map("estimated_minutes")
  status           TemplateStatus   @default(borrador)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocks   WorkoutBlock[]
  sessions ScheduledSession[]

  @@index([coachId, status])
  @@map("workout_templates")
}

model WorkoutBlock {
  id         String          @id @default(uuid()) @db.Uuid
  templateId String          @map("template_id") @db.Uuid
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  notes      String?

  exercises BlockExercise[]

  @@index([templateId, position])
  @@map("workout_blocks")
}

/// Prescripción planeada de un ejercicio. Exactamente un objetivo según
/// targetType (CHECK en SQL). La carga se guarda en kg; la distancia en metros.
model BlockExercise {
  id              String       @id @default(uuid()) @db.Uuid
  blockId         String       @map("block_id") @db.Uuid
  block           WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  /// NO ACTION: un ejercicio usado no puede borrarse, pero borrar la cuenta del
  /// coach (cascada simultánea de ejercicios y plantillas) sí funciona.
  exerciseId      String       @map("exercise_id") @db.Uuid
  exercise        Exercise     @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  position        Int
  sets            Int
  targetType      TargetType   @map("target_type")
  reps            Int?
  distanceMeters  Int?         @map("distance_meters")
  durationSeconds Int?         @map("duration_seconds")
  loadKg          Float?       @map("load_kg")
  restSeconds     Int?         @map("rest_seconds")
  notes           String?

  @@index([blockId, position])
  @@index([exerciseId])
  @@map("block_exercises")
}

enum ScheduledSessionStatus {
  programada
  cancelada

  @@map("scheduled_session_status")
}

/// Estado de la asignación de una sesión a un atleta. "retirada" = el coach lo
/// quitó (se conserva el historial). La fase de ejecución agregará más estados.
enum AssignmentStatus {
  asignada
  retirada

  @@map("assignment_status")
}

/// Sesión concreta programada por el coach a partir de una plantilla PUBLICADA.
/// snapshot = copia congelada de la plantilla al programar (JSON versionado):
/// editar o archivar la plantilla después no cambia la sesión.
model ScheduledSession {
  id            String                 @id @default(uuid()) @db.Uuid
  coachId       String                 @map("coach_id") @db.Uuid
  coach         CoachProfile           @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  /// Plantilla de origen (referencia informativa; la fuente de verdad es snapshot).
  templateId    String?                @map("template_id") @db.Uuid
  template      WorkoutTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title         String
  notes         String?
  /// Día de la sesión (sin hora ni zona horaria).
  scheduledDate DateTime               @map("scheduled_date") @db.Date
  /// Hora de inicio opcional "HH:MM" (hora local del gimnasio).
  startTime     String?                @map("start_time")
  status        ScheduledSessionStatus @default(programada)
  cancelledAt   DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  snapshot      Json
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments Assignment[]
  alerts      CoachAlert[]

  @@index([coachId, scheduledDate])
  @@map("scheduled_sessions")
}

/// Sesión asignada a un atleta. Al asignar, el atleta debe tener una relación
/// ACTIVA con el coach de la sesión (trigger en SQL).
model Assignment {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  session   ScheduledSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athleteId String           @map("athlete_id") @db.Uuid
  athlete   AthleteProfile   @relation(fields: [athleteId], references: [profileId], onDelete: Cascade)
  status    AssignmentStatus @default(asignada)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Registro realizado (fase 7). Nunca modifica el snapshot.
  log       SessionLog?
  /// Ajustes individuales sobre el snapshot (fase 10). Nunca modifican el snapshot.
  overrides AssignmentOverride[]

  @@unique([sessionId, athleteId])
  @@index([athleteId, status])
  @@map("assignments")
}

// ============================================================================
// Ejecución del atleta (fase 7): datos REALES, separados de lo planeado.
// Las series se ubican por su posición en el snapshot congelado de la sesión
// (bloque, ejercicio, serie), que nunca cambia.
// ============================================================================

enum SessionLogStatus {
  en_curso
  completada

  @@map("session_log_status")
}

enum DiscomfortZone {
  cuello
  hombro
  codo_muneca
  espalda_alta
  espalda_baja
  cadera
  muslo
  rodilla
  pantorrilla
  tobillo_pie
  otra

  @@map("discomfort_zone")
}

enum DiscomfortIntensity {
  leve
  moderada
  fuerte

  @@map("discomfort_intensity")
}

/// Una ejecución por asignación: inicio, pausas, fin y retroalimentación general.
model SessionLog {
  id            String           @id @default(uuid()) @db.Uuid
  assignmentId  String           @unique @map("assignment_id") @db.Uuid
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status        SessionLogStatus @default(en_curso)
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Inicio de la pausa actual (null si no está en pausa).
  pausedAt      DateTime?        @map("paused_at") @db.Timestamptz(6)
  /// Segundos en pausa ya cerrados (pausas anteriores).
  pausedSeconds Int              @default(0) @map("paused_seconds")
  finishedAt    DateTime?        @map("finished_at") @db.Timestamptz(6)
  /// RPE general de la sesión (1–10).
  rpe           Int?
  comment       String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sets        SetLog[]
  discomforts DiscomfortReport[]

  @@map("session_logs")
}

/// Resultado real de una serie. Lo planeado sigue en el snapshot.
model SetLog {
  id                    String     @id @default(uuid()) @db.Uuid
  sessionLogId          String     @map("session_log_id") @db.Uuid
  sessionLog            SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  blockIndex            Int        @map("block_index")
  exerciseIndex         Int        @map("exercise_index")
  /// Número de serie (empieza en 1).
  setNumber             Int        @map("set_number")
  actualReps            Int?       @map("actual_reps")
  actualDistanceMeters  Int?       @map("actual_distance_meters")
  actualDurationSeconds Int?       @map("actual_duration_seconds")
  actualLoadKg          Float?     @map("actual_load_kg")
  rpe                   Int?
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sessionLogId, blockIndex, exerciseIndex, setNumber])
  @@map("set_logs")
}

/// Reporte de molestia o dolor durante (o al final de) la sesión.
model DiscomfortReport {
  id            String              @id @default(uuid()) @db.Uuid
  sessionLogId  String              @map("session_log_id") @db.Uuid
  sessionLog    SessionLog          @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  zone          DiscomfortZone
  intensity     DiscomfortIntensity
  note          String?
  /// Ejercicio en curso al reportar (posición en el snapshot), si aplica.
  blockIndex    Int?                @map("block_index")
  exerciseIndex Int?                @map("exercise_index")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionLogId])
  @@map("discomfort_reports")
}

// ============================================================================
// Avisos operativos del coach (fase 9). Se generan de forma idempotente a
// partir de datos reales (molestias, ejecuciones, asignaciones, invitaciones);
// la tabla guarda el aviso y si ya se leyó, para conservar el historial.
// ============================================================================

enum AlertKind {
  molestia
  sesion_incompleta
  rpe_alto
  en_curso_prolongada
  no_iniciada
  relacion_aceptada

  @@map("alert_kind")
}

model CoachAlert {
  id          String            @id @default(uuid()) @db.Uuid
  coachId     String            @map("coach_id") @db.Uuid
  coach       CoachProfile      @relation(fields: [coachId], references: [profileId], onDelete: Cascade)
  /// SET NULL: el aviso sobrevive (con athlete_name) si se borra la cuenta del atleta.
  athleteId   String?           @map("athlete_id") @db.Uuid
  athlete     AthleteProfile?   @relation(fields: [athleteId], references: [profileId], onDelete: SetNull)
  sessionId   String?           @map("session_id") @db.Uuid
  session     ScheduledSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind        AlertKind
  /// Registro que originó el aviso (molestia, registro de sesión, asignación o invitación).
  sourceId    String            @map("source_id") @db.Uuid
  /// 1 prioritaria · 2 revisar · 3 seguimiento · 4 información.
  priority    Int
  title       String
  description String
  athleteName String            @map("athlete_name")
  /// Cuándo ocurrió el evento de origen (no cuándo se generó el aviso).
  eventAt     DateTime          @map("event_at") @db.Timestamptz(6)
  readAt      DateTime?         @map("read_at") @db.Timestamptz(6)
  /// Ya no requiere atención (p. ej. la sesión "no iniciada" se comenzó, se canceló o se retiró al atleta).
  /// No toca read_at: un aviso leído sigue leído; uno resuelto sale de pendientes y queda en el historial.
  resolvedAt  DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([coachId, kind, sourceId])
  @@index([coachId, readAt])
  @@map("coach_alerts")
}

// ============================================================================
// Personalización por atleta (fase 10). Un ajuste por asignación y elemento del
// snapshot (posición bloque/ejercicio). Nunca modifica la plantilla ni el
// snapshot; se bloquea en la BD en cuanto el atleta comienza la sesión.
// ============================================================================

model AssignmentOverride {
  id                      String            @id @default(uuid()) @db.Uuid
  assignmentId            String            @map("assignment_id") @db.Uuid
  assignment              Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Posición del ejercicio en el snapshot (la misma que usan set_logs).
  blockIndex              Int               @map("block_index")
  exerciseIndex           Int               @map("exercise_index")
  /// Omitido para este atleta: no aparece como serie pendiente.
  skipped                 Boolean           @default(false)
  overrideSets            Int?              @map("override_sets")
  /// Solo el objetivo del mismo tipo que el plan original (reps, distancia o tiempo).
  overrideReps            Int?              @map("override_reps")
  overrideDistanceMeters  Int?              @map("override_distance_meters")
  overrideDurationSeconds Int?              @map("override_duration_seconds")
  overrideLoadKg          Float?            @map("override_load_kg")
  /// "Sin carga": quita la carga planeada para este atleta.
  removeLoad              Boolean           @default(false) @map("remove_load")
  overrideRestSeconds     Int?              @map("override_rest_seconds")
  /// Nota para el atleta (también el motivo de una sustitución).
  note                    String?
  /// Sustitución: referencia a la biblioteca + copia congelada (no cambia si la biblioteca cambia).
  replacementExerciseId   String?           @map("replacement_exercise_id") @db.Uuid
  replacementExercise     Exercise?         @relation("OverrideReplacement", fields: [replacementExerciseId], references: [id], onDelete: SetNull)
  replacementName         String?           @map("replacement_name")
  replacementCategory     ExerciseCategory? @map("replacement_category")
  replacementEquipment    String[]          @default([]) @map("replacement_equipment")
  /// Auditoría básica: quién creó y quién modificó por última vez.
  createdById             String?           @map("created_by") @db.Uuid
  createdBy               CoachProfile?     @relation("OverrideCreatedBy", fields: [createdById], references: [profileId], onDelete: SetNull)
  updatedById             String?           @map("updated_by") @db.Uuid
  updatedBy               CoachProfile?     @relation("OverrideUpdatedBy", fields: [updatedById], references: [profileId], onDelete: SetNull)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assignmentId, blockIndex, exerciseIndex])
  @@index([replacementExerciseId])
  @@map("assignment_overrides")
}
